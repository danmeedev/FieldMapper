{
  "name": "field-mapper",
  "version": "1.1.2",
  "description": "Offline field mapping with phone GPS for mining",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "download": "node download-tiles.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.cjs",
    "package:windows": "pwsh -NoProfile -File scripts/build-package.ps1",
    "test:package": "node tests/package-smoke.cjs",
    "check:privacy": "node scripts/check-privacy.cjs",
    "check:distribution": "node scripts/check-distribution.cjs",
    "test:updates:live": "node scripts/verify-live-updates.cjs",
    "test:sharing": "node tests/sharing-browser.cjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "marked": "^18.1.1",
    "playwright": "^1.64.1"
  }
}
