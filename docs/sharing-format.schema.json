{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldmapper.invalid/schemas/sharing-v1.json",
  "title": "Field Mapper offline interchange protocol 1",
  "description": "Documentation contract; runtime validates bounds, image integrity, safe keys, coordinates and typed links separately. App version is informational. Unknown properties remain portable.",
  "type": "object",
  "required": [
    "format",
    "version",
    "packageId",
    "records",
    "attachments"
  ],
  "properties": {
    "format": {
      "const": "fieldmapper-share"
    },
    "version": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdAt": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "origin": {
      "type": "object",
      "required": [
        "source",
        "id"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "additionalProperties": true
    },
    "record": {
      "type": "object",
      "required": [
        "type",
        "schema",
        "origin",
        "data"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "data": {
          "type": "object"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "type",
              "origin"
            ],
            "properties": {
              "path": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              },
              "type": {
                "type": "string"
              },
              "origin": {
                "$ref": "#/$defs/origin"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "attachment": {
      "type": "object",
      "required": [
        "id",
        "encoding",
        "mediaType",
        "bytes",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "const": "base64"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.+-]+/[a-zA-Z0-9.+-]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "additionalProperties": true
    }
  }
}
